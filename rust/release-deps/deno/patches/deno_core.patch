+  /// Attach a module graph to an embedder-created context sharing this runtime's
+  /// ContextState. The embedder must authenticate its loader and reject imports
+  /// after retirement. No JavaScript core/op-driver state is replaced.
+  pub fn register_module_context(
+    scope: &mut v8::PinScope,
+    loader: Rc<dyn ModuleLoader>,
+  ) -> bool {
+    let context = scope.get_current_context();
+    if context.get_aligned_pointer_from_embedder_data(
+      super::jsrealm::CONTEXT_STATE_SLOT_INDEX,
+    ).is_null() {
+      return false;
+    }
+    let state = Self::state_from(scope);
+    let contexts = state.module_contexts.borrow().clone();
+    for entry in contexts {
+      if entry.context.to_local(scope).is_some_and(|owner| owner == context) {
+        return entry.active.get();
+      }
+    }
+    let context_state = JsRealm::state_from_scope(scope);
+    let modules = Rc::new(ModuleMap::new(
+      loader,
+      state.source_mapper.clone(),
+      context_state.exception_state.clone(),
+      false,
+    ));
+    // SAFETY: the registry retains the map until its weak context is collected.
+    unsafe {
+      context.set_aligned_pointer_in_embedder_data(
+        super::jsrealm::MODULE_MAP_SLOT_INDEX,
+        Rc::as_ptr(&modules) as *mut c_void,
+      );
+    }
+    state.module_contexts.borrow_mut().push(Rc::new(ModuleContext {
+      context: v8::Weak::new(scope, context),
+      modules,
+      active: Cell::new(true),
+      busy: Cell::new(0),
+      cancellation_waker: Default::default(),
+    }));
+    true
+  }
+
+  /// Cancel this registered context's module work without closing the shared
+  /// ContextState/op driver. Retain its map allocation for future V8 callbacks;
+  /// the embedder must reject new imports from the retired context.
+  pub fn detach_module_context<'s>(
+    scope: &mut v8::PinScope<'s, '_>,
+    context: v8::Local<'s, v8::Context>,
+  ) {
+    let state = Self::state_from(scope);
+    let contexts = state.module_contexts.borrow().clone();
+    for entry in contexts {
+      if entry.context.to_local(scope).is_some_and(|owner| owner == context)
+        && entry.active.replace(false)
+      {
+        entry.cancellation_waker.wake();
+        state.waker.wake();
+        if entry.busy.get() == 0 {
+          entry.modules.destroy();
+        }
+        return;
+      }
+    }
+  }
