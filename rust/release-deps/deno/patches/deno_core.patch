+
+impl ModuleContext {
+  fn check_active(&self, cx: Option<&Context>) -> Result<(), CoreError> {
+    if let Some(cx) = cx {
+      self.cancellation_waker.register(cx.waker());
+    }
+    if self.active.get() {
+      return Ok(());
+    }
