+// Copyright 2018-2026 the Deno authors. MIT license.
+
+use super::JsRuntime;
+use super::ModuleContextWork;
+use crate::NoopModuleLoader;
+use crate::RuntimeOptions;
+use std::rc::Rc;
+
+fn native_context(runtime: &mut JsRuntime) -> v8::Global<v8::Context> {
+  crate::scope!(scope, runtime);
+  let initial = scope.get_current_context();
+  let state = initial.get_aligned_pointer_from_embedder_data(
+    crate::runtime::jsrealm::CONTEXT_STATE_SLOT_INDEX,
+  );
+  let modules = initial.get_aligned_pointer_from_embedder_data(
+    crate::runtime::jsrealm::MODULE_MAP_SLOT_INDEX,
+  );
+  let context = v8::Context::new(scope, Default::default());
+  // SAFETY: this runtime owns the borrowed slots until its native contexts drop.
+  unsafe {
+    context.set_aligned_pointer_in_embedder_data(
+      crate::runtime::jsrealm::CONTEXT_STATE_SLOT_INDEX,
+      state,
+    );
+    context.set_aligned_pointer_in_embedder_data(
+      crate::runtime::jsrealm::MODULE_MAP_SLOT_INDEX,
+      modules,
+    );
+  }
+  v8::Global::new(scope, context)
+}
+
+fn register(
+  runtime: &mut JsRuntime,
+  context: &v8::Global<v8::Context>,
+) -> bool {
+  crate::scope!(scope, runtime);
+  let context = v8::Local::new(scope, context);
+  let scope = &mut v8::ContextScope::new(scope, context);
+  JsRuntime::register_module_context(scope, Rc::new(NoopModuleLoader))
+}
+
+fn cancel(runtime: &mut JsRuntime, context: &v8::Global<v8::Context>) -> bool {
+  crate::scope!(scope, runtime);
+  let context = v8::Local::new(scope, context);
+  let scope = &mut v8::ContextScope::new(scope, context);
+  JsRuntime::cancel_module_context_pending_work(scope, context)
+}
+
+#[test]
+fn pending_module_cancel_requires_a_live_registered_native_context() {
+  let mut runtime = JsRuntime::new(RuntimeOptions::default());
+  let unregistered = native_context(&mut runtime);
+  assert!(!cancel(&mut runtime, &unregistered));
+
+  let registered = native_context(&mut runtime);
+  assert!(register(&mut runtime, &registered));
+  assert!(cancel(&mut runtime, &registered));
+  {
+    crate::scope!(scope, &mut runtime);
+    let context = v8::Local::new(scope, &registered);
+    JsRuntime::detach_module_context(scope, context);
+  }
+  assert!(!cancel(&mut runtime, &registered));
+  assert!(!register(&mut runtime, &registered));
+  assert!(!cancel(&mut runtime, &unregistered));
+}
+
+#[test]
+fn pending_module_cancel_rejects_an_in_flight_registered_operation() {
+  let mut runtime = JsRuntime::new(RuntimeOptions::default());
+  let context = native_context(&mut runtime);
+  assert!(register(&mut runtime, &context));
+  let state = JsRuntime::state_from(runtime.v8_isolate());
+  let entry = {
+    let contexts = state.module_contexts.borrow();
+    assert_eq!(contexts.len(), 1);
+    contexts[0].clone()
+  };
+  // Hold the exact RAII guard used by registered load/evaluation operations;
+  // no guest flag or test-only production admission path is introduced.
+  let operation = ModuleContextWork::enter(entry.clone());
+  assert_eq!(entry.busy.get(), 1);
+  assert!(!cancel(&mut runtime, &context));
+  assert!(entry.active.get());
+  drop(operation);
+  assert_eq!(entry.busy.get(), 0);
+  assert!(cancel(&mut runtime, &context));
+  assert!(entry.active.get());
+}
