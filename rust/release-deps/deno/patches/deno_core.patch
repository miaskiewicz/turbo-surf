+// The embedder's ContextState/op driver stays shared; only module work is owned.
+struct ModuleContext {
+  context: v8::Weak<v8::Context>,
+  modules: Rc<ModuleMap>,
+  active: Cell<bool>,
+  busy: Cell<u32>,
+  cancellation_waker: AtomicWaker,
+}
+
+impl ModuleContext {
+  fn check_active(&self, cx: Option<&Context>) -> Result<(), CoreError> {
+    if let Some(cx) = cx {
+      self.cancellation_waker.register(cx.waker());
+    }
+    if self.active.get() {
+      return Ok(());
+    }
+    Err(
+      CoreErrorKind::JsBox(JsErrorBox::type_error(
+        "Module context was retired while loading",
+      ))
+      .into_box(),
+    )
+  }
+}
+
+struct ModuleContextWork(Rc<ModuleContext>);
+
+impl ModuleContextWork {
+  fn enter(entry: Rc<ModuleContext>) -> Self {
+    entry.busy.set(entry.busy.get() + 1);
+    Self(entry)
+  }
+}
+
+impl Drop for ModuleContextWork {
+  fn drop(&mut self) {
+    self.0.busy.set(self.0.busy.get() - 1);
+    if self.0.busy.get() == 0 && !self.0.active.get() {
+      self.0.modules.destroy();
+    }
+  }
+}
