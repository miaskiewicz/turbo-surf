+  /// Attach an independent module graph to the current embedder-created context.
+  /// The context must already share this runtime's ContextState/op-driver slot.
+  /// Its loader determines its authenticated base URL and fetch policy.
+  pub fn register_module_context(scope: &mut v8::PinScope, loader: Rc<dyn ModuleLoader>) -> bool {
+    let context = scope.get_current_context();
+    let index = super::jsrealm::CONTEXT_STATE_SLOT_INDEX;
+    if context
+      .get_aligned_pointer_from_embedder_data(index)
+      .is_null()
+    {
+      return false;
+    }
+    let state = Self::state_from(scope);
+    let contexts = state.module_contexts.borrow().clone();
+    if contexts
+      .iter()
+      .any(|entry| {
+        entry.context.to_local(scope).is_some_and(|owner| owner == context)
+      })
+    {
+      return true;
+    }
+    let context_state = JsRealm::state_from_scope(scope);
+    let modules = Rc::new(ModuleMap::new(
+      loader,
+      state.source_mapper.clone(),
+      context_state.exception_state.clone(),
+      false,
+    ));
+    // SAFETY: module_contexts retains this allocation while its context is live.
+    unsafe {
+      context.set_aligned_pointer_in_embedder_data(
+        super::jsrealm::MODULE_MAP_SLOT_INDEX,
+        Rc::as_ptr(&modules) as *mut std::ffi::c_void,
+      );
+    }
+    state
+      .module_contexts
+      .borrow_mut()
+      .push(Rc::new(ModuleContext {
+        context: v8::Weak::new(scope, context),
+        modules,
+        active: Cell::new(true),
+      }));
+    true
+  }
+
+  /// Cancel a retired context's module work while preserving callback pointer
+  /// validity. Future imports must be denied by the embedder's native policy.
+  pub fn detach_module_context(scope: &mut v8::PinScope, context: v8::Local<v8::Context>) {
+    let state = Self::state_from(scope);
+    for entry in state.module_contexts.borrow().iter() {
+      if entry.context.to_local(scope).is_some_and(|owner| owner == context)
+        && entry.active.replace(false)
+      {
+        entry.modules.destroy();
+        break;
+      }
+    }
+  }
