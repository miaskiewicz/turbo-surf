#!/usr/bin/env bash
# turbo-surf pre-commit gate. The engine is Rust (see rust/ — gated by `cargo test
# / clippy / fmt`, run via `npm run check`). The only JS left is the thin launcher
# (cli.js/index.js) + the dev harness, so this hook just lints/formats staged JS.
# Enable once with:  git config core.hooksPath .githooks  (or: npm run prepare)
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1

status=0
fail() { echo "  ✖ $1"; status=1; }

# Vendored files are byte-for-byte upstream copies (the turbo-test DOM binding
# `browser_env.js`) — never lint/reformat them (re-vendoring overwrites them, and
# oxlint/biome ignore configs don't apply to explicitly-passed paths, so filter here).
# biome/oxlint ignore configs don't apply to explicitly-passed paths, and biome
# refuses lockfiles (default-ignored → "no files processed" → exit 1), so filter
# both the vendored binding and package-lock.json out of the staged set here.
VENDORED='(^rust/crates/turbo-surf-render/src/form_controls\.js$|^rust/crates/turbo-surf-render/src/(form_methods|form_reflection|control_prototypes|css_descriptor|form_connectivity|form_entrylist|formdata_constructor|element_internals|checkedness|formdata_event|formdata_guards).*\.(js|json)$|^rust/crates/turbo-surf-render/src/(custom_elements|template_|shadow_slots|iframe_credentialless|css_selector_lexemes|abstract_ranges).*\.(js|json)$|^rust/crates/turbo-surf-render/src/trusted_types.*\.(js|json)$|^rust/crates/turbo-surf-render/src/script_text.*\.(js|json)$|^rust/crates/turbo-surf-render/src/utf16_.*\.(js|json)$|^rust/vendor/|^rust/crates/turbo-surf-render/src/xpath_provider/|((^|/)element_interface_probe\.js|(^|/)element_interface_chrome155\.json|(^|/)script_preparation_probe\.js|(^|/)script_preparation_chrome155\.json|(^|/)mutation_observers\.js|(^|/)mutation_observers_probe\.js|(^|/)mutation_observers_chrome155\.json|(^|/)xml_factory_elements_probe\.js|(^|/)xml_factory_elements_chrome155\.json|(^|/)dom_implementation\.js|(^|/)dom_implementation_probe\.js|(^|/)dom_implementation_chrome155\.json|(^|/)browser_env\.js|(^|/)document_basics\.js|(^|/)document_xpath\.js|(^|/)event_listeners\.js|(^|/)range_contents\.js|(^|/)css_adoption_probe\.js|(^|/)css_adoption_ownership_probe\.js|(^|/)css_adoption_chrome155\.json|(^|/)css_adoption_ownership_chrome155\.json|(^|/)frame_tokens_probe\.js|(^|/)frame_tokens_chrome155\.json|(^|/)html_meta_probe\.js|(^|/)html_meta_chrome155\.json|(^|/)computed_color_probe\.js|(^|/)computed_color_chrome155\.json|(^|/)css_live_probe\.js|(^|/)css_live_chrome155\.json|(^|/)dom_variadic_errors_probe\.js|(^|/)dom_variadic_errors_chrome155\.json|(^|/)dom_adoption_probe\.js|(^|/)dom_adoption_chrome155\.json|(^|/)range_live_probe\.js|(^|/)range_live_chrome155\.json|(^|/)range_probe\.js|(^|/)range_chrome155\.json|(^|/)element_tokens\.js|(^|/)element_relations\.js|(^|/)html_text\.js|(^|/)html_popover\.js|(^|/)browser_sanitizer_default\.json|(^|/)package-lock\.json)$)'
staged="$(git diff --cached --name-only --diff-filter=ACM | grep -vE "$VENDORED" || true)"
js_files="$(echo "$staged"  | grep -E '\.(mjs|js|cjs)$'             || true)"
fmt_files="$(echo "$staged" | grep -E '\.(mjs|js|cjs|json|jsonc)$' || true)"

have() { command -v "$1" >/dev/null 2>&1; }
runjs() { if have npx; then npx --no-install "$@"; else return 127; fi; }

if [ -n "$js_files" ] || [ -n "$fmt_files" ]; then
  echo "• JS gates"
  # 1. oxlint
  if [ -n "$js_files" ]; then
    runjs oxlint $js_files || fail "oxlint reported problems"
  fi
  # 2. biome format (auto-fix, then re-stage)
  if [ -n "$fmt_files" ]; then
    if runjs biome format --write $fmt_files; then
      echo "$fmt_files" | xargs git add
    else
      fail "biome formatting failed"
    fi
  fi
fi

if [ "$status" -ne 0 ]; then
  echo "✖ pre-commit gate failed. Fix the above and re-commit."
fi
exit "$status"
