[
  { "name": "domparser", "probe": "sanitizer-domparser-probe.js" },
  {
    "name": "declarative-scripts",
    "probe": "sanitizer-declarative-scripts-probe.js",
    "page": "sanitizer-declarative-scripts.html"
  },
  {
    "name": "trusted-types",
    "probe": "sanitizer-trusted-types-probe.js",
