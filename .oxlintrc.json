{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "plugins": ["import", "unicorn"],
  "env": {
    "node": true,
    "es2024": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "rules": {
    "no-console": "off",
    "eqeqeq": "error",
    "no-var": "error",
    "prefer-const": "error"
  },
  "ignorePatterns": [
    "rust/crates/turbo-surf-render/src/element_interface_probe.js",
    "rust/crates/turbo-surf-render/src/element_interface_chrome155.json",
    "rust/crates/turbo-surf-render/src/document_basics.js",
    "rust/crates/turbo-surf-render/src/script_preparation_probe.js",
    "rust/crates/turbo-surf-render/src/script_preparation_chrome155.json",
    "rust/crates/turbo-surf-render/src/mutation_observers.js",
    "rust/crates/turbo-surf-render/src/mutation_observers_probe.js",
    "rust/crates/turbo-surf-render/src/mutation_observers_chrome155.json",
    "rust/crates/turbo-surf-render/src/xml_factory_elements_probe.js",
    "rust/crates/turbo-surf-render/src/xml_factory_elements_chrome155.json",
    "rust/crates/turbo-surf-render/src/dom_implementation.js",
    "rust/crates/turbo-surf-render/src/dom_implementation_probe.js",
    "rust/crates/turbo-surf-render/src/dom_implementation_chrome155.json",
    "rust/vendor/**",
    "rust/crates/turbo-surf-render/src/document_xpath.js",
    "rust/crates/turbo-surf-render/src/event_listeners.js",
    "rust/crates/turbo-surf-render/src/range_contents.js",
    "rust/crates/turbo-surf-render/src/css_live_probe.js",
    "rust/crates/turbo-surf-render/src/css_live_chrome155.json",
    "rust/crates/turbo-surf-render/src/css_adoption_probe.js",
    "rust/crates/turbo-surf-render/src/css_adoption_ownership_probe.js",
    "rust/crates/turbo-surf-render/src/css_adoption_chrome155.json",
    "rust/crates/turbo-surf-render/src/css_adoption_ownership_chrome155.json",
    "rust/crates/turbo-surf-render/src/range_live_probe.js",
    "rust/crates/turbo-surf-render/src/range_live_chrome155.json",
    "rust/crates/turbo-surf-render/src/dom_adoption_probe.js",
    "rust/crates/turbo-surf-render/src/dom_adoption_chrome155.json",
    "rust/crates/turbo-surf-render/src/dom_variadic_errors_probe.js",
    "rust/crates/turbo-surf-render/src/dom_variadic_errors_chrome155.json",
    "rust/crates/turbo-surf-render/src/range_probe.js",
    "rust/crates/turbo-surf-render/src/range_chrome155.json",
    "rust/crates/turbo-surf-render/src/xpath_provider/**",
    "**/dist/**",
    "**/node_modules/**",
    "**/coverage/**",
    "test/fixtures/**",
    "**/browser_env.js",
    "rust/crates/turbo-surf-render/src/element_tokens.js",
    "rust/crates/turbo-surf-render/src/element_relations.js",
    "rust/crates/turbo-surf-render/src/html_text.js",
    "rust/crates/turbo-surf-render/src/html_popover.js",
    ".native-builds/**"
  ]
}
