# turbo-surf challenge-solver config (optional).
#
# Copy to `.env` and select a solver, or supply a supported provider key.
# Unset/unknown selectors auto-select a real Hyper key first, then Scrapfly;
# with neither key, no solver is installed. Explicit in-house solvers need no key.
# Placeholder values below are recognised as unset. See docs/SOLVERS.md for
# actual provider coverage, fallback behavior and acceptance limitations.
#
# `.env` is gitignored — never commit real keys.

# Which solver to use:
#   cloudflare | awswaf | akamai | recaptcha — in-house/experimental, no provider key;
#                                   optional browser fallback on solve errors.
#   hyper | scrapfly              — rented token APIs (need the key below)
#   browser                       — self-owned hardened-headless sidecar (cmd below)
# Selecting a solver does not guarantee that a live challenge or replay is accepted.
TURBO_SURF_SOLVER=

# Hyper Solutions: the wired adapter supports Akamai sensor generation.
# https://hypersolutions.co
HYPER_API_KEY=your_hyper_api_key_here

# Scrapfly ASP: external rendered scrape/cookie adapter; requires its provider key.
# https://scrapfly.io
SCRAPFLY_API_KEY=your_scrapfly_api_key_here

# Browser sidecar command for solver=browser. Also enables optional fallback for
# each in-house solver when its solve operation returns an error.
TURBO_SURF_BROWSER_CMD=

# Where analyze_akamai's `retry` saves a working sensor (default: akamai-sensors).
TURBO_SURF_SENSOR_DIR=

# Proxy hint passed to solver adapters; this variable alone does not configure
# the native replay transport. Verify adapter support and actual replay egress.
# Format: http://user:pass@host:port
TURBO_SURF_PROXY=
