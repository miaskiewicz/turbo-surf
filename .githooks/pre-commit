#!/usr/bin/env bash
# turbo-surf pre-commit gate. The engine is Rust (see rust/ — gated by `cargo test
# / clippy / fmt`, run via `npm run check`). The only JS left is the thin launcher
# (cli.js/index.js) + the dev harness, so this hook just lints/formats staged JS.
# Enable once with:  git config core.hooksPath .githooks  (or: npm run prepare)
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1

status=0
fail() { echo "  ✖ $1"; status=1; }

# Captured Chrome probes, cases and controls keep exact bytes for source-bound
# oracle comparisons — never lint/reformat them. biome/oxlint ignore configs don't
# apply to explicitly-passed paths, and biome refuses lockfiles (default-ignored →
# "no files processed" → exit 1), so filter both those files and package-lock.json
# out of the staged set here. (The DOM binding and its probes are the
# turbo-dom-browser-env crate dependency, and the Deno extension JS comes from the
# deno crates' embedded sources; none of it lives in this repo.)
VENDORED='(^harness/detection/document-hooks-(cases\.json|probe\.js|report\.js)$|^harness/detection/fixtures/document_hooks(_headless)?_chrome156\.json$|^harness/detection/element-(scroll|scroll-events|visibility)-probe\.js$|^harness/detection/pointer-capture-(probe\.js|cases\.json)$|^harness/detection/fixtures/pointer-capture-chrome156\.json$|^harness/detection/fixtures/element-scroll-chrome156\.json$|^harness/detection/fixtures/(idl-constructor|timer-conversion|font-range-diagnostic|embedded-font-range|border-cascade)-probe\.js$|^harness/detection/fixtures/embedded-font-range-chrome-setup\.js$|((^|/)package-lock\.json)$|^harness/detection/(observable-shape|observable-semantics|blob-text-stream)-probe\.js$|^harness/detection/fixtures/web-apis-chrome156\.json$|^harness/detection/(privacy-sandbox|form-multipart)-(probe\.js|chrome\.mjs)$|^harness/detection/fixtures/(privacy_sandbox|form_multipart)_chrome156\.json$|^harness/detection/typed-om-probe\.js$|^harness/detection/fixtures/typed-om-chrome156\.json$|^harness/detection/(zoom-layout|root-viewport|image-input-size)-probe\.js$|^harness/detection/fixtures/zoom-layout-chrome156\.json$|^harness/detection/chrome-identity-probe\.js$|^harness/detection/(history-location|viewport-orientation|interface-shapes|observers|transports)-probe\.js$|^harness/detection/fixtures/window-interfaces-chrome156\.json$|^harness/detection/sanitizer-[a-z-]+-probe\.js$|^harness/detection/sanitizer-declarative-scripts\.html$|^harness/detection/fixtures/sanitizer-chrome156\.json$|^harness/detection/user-activation-gates-cases\.json$|^harness/detection/fixtures/user_activation_gates_chrome156\.json$)'
staged="$(git diff --cached --name-only --diff-filter=ACM | grep -vE "$VENDORED" || true)"
js_files="$(echo "$staged"  | grep -E '\.(mjs|js|cjs)$'             || true)"
fmt_files="$(echo "$staged" | grep -E '\.(mjs|js|cjs|json|jsonc)$' || true)"

have() { command -v "$1" >/dev/null 2>&1; }
runjs() { if have npx; then npx --no-install "$@"; else return 127; fi; }

if [ -n "$js_files" ] || [ -n "$fmt_files" ]; then
  echo "• JS gates"
  # 1. oxlint
  if [ -n "$js_files" ]; then
    runjs oxlint $js_files || fail "oxlint reported problems"
  fi
  # 2. biome format (auto-fix, then re-stage)
  if [ -n "$fmt_files" ]; then
    if runjs biome format --write $fmt_files; then
      echo "$fmt_files" | xargs git add
    else
      fail "biome formatting failed"
    fi
  fi
fi

if [ "$status" -ne 0 ]; then
  echo "✖ pre-commit gate failed. Fix the above and re-commit."
fi
exit "$status"
