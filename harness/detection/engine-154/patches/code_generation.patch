+static v8::Local<v8::Private> code_generation_callback_key(v8::Isolate* isolate) {
+  return v8::Private::ForApi(
+      isolate, v8::String::NewFromUtf8Literal(isolate, "turbo-surf.code-generation-callback"));
+}
+
+static v8::ModifyCodeGenerationFromStringsResult code_generation_callback(
+    v8::Local<v8::Context> context, v8::Local<v8::Value> source, bool is_code_like) {
+  auto isolate = v8::Isolate::GetCurrent();
+  v8::ModifyCodeGenerationFromStringsResult result;
+  v8::Local<v8::Value> callback;
+  if (!context->Global()->GetPrivate(context, code_generation_callback_key(isolate))
+           .ToLocal(&callback) || !callback->IsFunction()) {
+    result.codegen_allowed = context->IsCodeGenerationFromStringsAllowed();
+    return result;
+  }
+  v8::Local<v8::Value> args[] = {source, v8::Boolean::New(isolate, is_code_like)};
+  v8::Local<v8::Value> allowed;
+  if (callback.As<v8::Function>()->Call(context, v8::Undefined(isolate), 2, args)
+          .ToLocal(&allowed)) {
+    result.codegen_allowed = allowed->IsTrue() || allowed->IsString();
+    if (allowed->IsString()) {
+      result.modified_source = allowed.As<v8::String>();
+    } else if (allowed->IsArray()) {
+      auto detail = allowed.As<v8::Array>();
+      v8::Local<v8::Value> message;
+      if (detail->Length() == 1 && detail->Get(context, 0).ToLocal(&message) &&
+          message->IsString()) {
+        context->SetErrorMessageForCodeGenerationFromStrings(message.As<v8::String>());
+      }
+    }
+  }
+  return result;
+}
+
+bool v8__Context__SetCodeGenerationCallback(const v8::Context& self,
+                                            const v8::Function& callback) {
+  auto context = ptr_to_local(&self);
+  auto isolate = v8::Isolate::GetCurrent();
+  auto function = ptr_to_local(&callback);
+  v8::Local<v8::Context> creation;
+  if (function->IsProxy() || !function->GetBoundFunction()->IsUndefined() ||
+      !function->GetCreationContext(isolate).ToLocal(&creation) || creation != context) {
+    return false;
+  }
+  if (!context->Global()->SetPrivate(context, code_generation_callback_key(isolate),
+                                    ptr_to_local(&callback)).FromMaybe(false)) {
+    return false;
+  }
+  isolate->SetModifyCodeGenerationFromStringsCallback(code_generation_callback);
+  return true;
+}
