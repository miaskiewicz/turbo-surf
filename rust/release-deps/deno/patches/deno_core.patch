+struct ModuleContextWork(Rc<ModuleContext>);
+
+impl ModuleContextWork {
+  fn enter(entry: Rc<ModuleContext>) -> Self {
+    entry.busy.set(entry.busy.get() + 1);
+    Self(entry)
+  }
