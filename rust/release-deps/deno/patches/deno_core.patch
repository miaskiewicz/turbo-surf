+// Copyright 2018-2026 the Deno authors. MIT license.
+//! Host-only observations of genuine native asynchronous op promises.
+use std::collections::HashMap;
+use std::rc::Rc;
+
+/// Lifecycle of one real op-driver promise. Eagerly completed ops have no
+/// pending promise and do not emit these observations.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum AsyncOpEvent {
+  Registered,
+  Refed,
+  Unrefed,
+  Settled,
+  TrackingFailed,
+}
+
+/// The Promise is supplied only on registration, before it leaves trusted core.
+/// Embedders must use weak handles and must not execute authored JavaScript from
+/// this callback. Promise IDs are opaque and may be reused after completion.
+pub struct AsyncOpObservation<'s> {
+  pub promise_id: i32,
+  pub generation: u64,
+  pub event: AsyncOpEvent,
+  pub promise: Option<v8::Local<'s, v8::Promise>>,
+}
+
+/// Native observers cannot throw a guest exception into op bookkeeping.
+#[derive(Clone)]
+pub struct AsyncOpObserver(
+  pub Rc<dyn for<'s, 'i> Fn(&mut v8::PinScope<'s, 'i>, AsyncOpObservation<'s>)>,
+);
+
+#[derive(Default)]
+struct ActiveOps {
+  generation: u64,
+  failed: bool,
+  entries: HashMap<i32, u64>,
+}
+
+impl ActiveOps {
+  fn observe(&mut self, id: i32, event: AsyncOpEvent) -> Option<u64> {
+    match event {
+      AsyncOpEvent::Registered => {
+        if self.entries.contains_key(&id) {
+          return None;
+        }
+        let Some(generation) = self.generation.checked_add(1) else {
+          self.failed = true;
+          return None;
+        };
+        self.generation = generation;
+        self.entries.insert(id, self.generation);
+        Some(self.generation)
+      }
+      AsyncOpEvent::Settled => self.entries.remove(&id),
+      AsyncOpEvent::Refed | AsyncOpEvent::Unrefed => self.entries.get(&id).copied(),
+      AsyncOpEvent::TrackingFailed => None,
+    }
+  }
+}
+
+pub(crate) fn notify<'s, 'i>(
+  scope: &mut v8::PinScope<'s, 'i>,
+  promise_id: i32,
+  event: AsyncOpEvent,
+  promise: Option<v8::Local<'s, v8::Promise>>,
+) {
+  let state = crate::JsRuntime::op_state_from(scope);
+  let (generation, event, observer) = {
+    let mut state = state.borrow_mut();
+    if !state.has::<ActiveOps>() {
+      state.put(ActiveOps::default());
+    }
+    let active = state.borrow_mut::<ActiveOps>();
+    let mut generation = active.observe(promise_id, event);
+    let event = if active.failed {
+      generation = Some(0);
+      AsyncOpEvent::TrackingFailed
+    } else {
+      event
+    };
+    let observer = state.try_borrow::<AsyncOpObserver>().cloned();
+    (generation, event, observer)
+  };
+  if let (Some(generation), Some(observer)) = (generation, observer) {
+    let promise = if event == AsyncOpEvent::Registered {
+      promise
+    } else {
+      None
+    };
+    (observer.0)(
+      scope,
+      AsyncOpObservation {
+        promise_id,
+        generation,
+        event,
+        promise,
+      },
+    );
+  }
+}
+
+#[cfg(test)]
+mod tests {
+  use super::{ActiveOps, AsyncOpEvent};
+
+  #[test]
+  fn native_generation_overflow_fails_closed_without_registering() {
+    let mut active = ActiveOps {
+      generation: u64::MAX,
+      ..Default::default()
+    };
+    assert_eq!(active.observe(7, AsyncOpEvent::Registered), None);
+    assert!(active.failed);
+    assert!(active.entries.is_empty());
+    assert_eq!(active.observe(8, AsyncOpEvent::Registered), None);
+    assert!(active.failed);
+    assert!(active.entries.is_empty());
+    assert_eq!(active.observe(-1, AsyncOpEvent::Refed), None);
+    assert!(active.failed);
+  }
+}
