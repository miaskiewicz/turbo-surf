{
  "$schema": "https://biomejs.dev/schemas/1.9.0/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": false
  },
  "files": {
    "ignore": [
      "harness/detection/pointer-capture-probe.js",
      "harness/detection/pointer-capture-cases.json",
      "harness/detection/fixtures/pointer-capture-chrome156.json",
      "harness/detection/privacy-sandbox-probe.js",
      "harness/detection/privacy-sandbox-chrome.mjs",
      "harness/detection/fixtures/privacy_sandbox_chrome156.json",
      "harness/detection/form-multipart-probe.js",
      "harness/detection/form-multipart-chrome.mjs",
      "harness/detection/fixtures/form_multipart_chrome156.json",
      "harness/detection/typed-om-probe.js",
      "harness/detection/fixtures/typed-om-chrome156.json",
      "harness/detection/element-scroll-probe.js",
      "harness/detection/element-scroll-events-probe.js",
      "harness/detection/element-visibility-probe.js",
      "harness/detection/chrome-identity-probe.js",
      "harness/detection/fixtures/element-scroll-chrome156.json",
      "harness/detection/observable-shape-probe.js",
      "harness/detection/observable-semantics-probe.js",
      "harness/detection/blob-text-stream-probe.js",
      "harness/detection/fixtures/web-apis-chrome156.json",
      "harness/detection/zoom-layout-probe.js",
      "harness/detection/root-viewport-probe.js",
      "harness/detection/image-input-size-probe.js",
      "harness/detection/fixtures/zoom-layout-chrome156.json",
      "harness/detection/history-location-probe.js",
      "harness/detection/viewport-orientation-probe.js",
      "harness/detection/interface-shapes-probe.js",
      "harness/detection/observers-probe.js",
      "harness/detection/transports-probe.js",
      "harness/detection/fixtures/window-interfaces-chrome156.json",
      "harness/detection/sanitizer-*-probe.js",
      "harness/detection/sanitizer-declarative-scripts.html",
      "harness/detection/fixtures/sanitizer-chrome156.json",
      "**/dist/**",
      "**/node_modules/**",
      "**/coverage/**",
      "**/target/**",
      "**/storage/**",
      "**/package-lock.json",
      ".sidecar/**",
      "**/.chrome-profile/**",
      "harness/detection/artifacts/**",
      "harness/detection/fixtures/idl-constructor-probe.js",
      "harness/detection/fixtures/border-cascade-probe.js",
      "harness/detection/fixtures/embedded-font-range-probe.js",
      "harness/detection/fixtures/embedded-font-range-chrome-setup.js",
      "harness/detection/fixtures/timer-conversion-probe.js",
      "harness/detection/fixtures/font-range-diagnostic-probe.js",
      "harness/detection/document-hooks-cases.json",
      "harness/detection/document-hooks-probe.js",
      "harness/detection/document-hooks-report.js",
      "harness/detection/fixtures/document_hooks*_chrome156.json",
      "harness/detection/user-activation-gates-cases.json",
      "harness/detection/fixtures/user_activation_gates_chrome156.json",
      ".native-builds/**"
    ]
  }
}
