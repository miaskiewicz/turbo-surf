{
  "$schema": "https://biomejs.dev/schemas/1.9.0/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": false
  },
  "files": {
    "ignore": [
      "**/dist/**",
      "**/node_modules/**",
      "**/coverage/**",
      "**/target/**",
      "test/fixtures/**",
      "**/storage/**",
      "**/package-lock.json",
      "**/browser_env.js",
      "rust/crates/turbo-surf-render/src/document_basics.js",
      "rust/crates/turbo-surf-render/src/element_tokens.js",
      "rust/crates/turbo-surf-render/src/element_relations.js",
      "rust/crates/turbo-surf-render/src/html_text.js",
      "rust/crates/turbo-surf-render/src/html_popover.js",
      "rust/crates/turbo-surf-render/src/browser_sanitizer_default.json",
      ".sidecar/**",
      "**/.chrome-profile/**",
      "harness/detection/artifacts/**",
      ".native-builds/**"
    ]
  }
}
