+// Copyright 2018-2026 the Deno authors. MIT license.
+use super::*;
+
+/// Work performed by an embedder's document-task rejection checkpoint.
+#[derive(Debug, Default, PartialEq, Eq)]
+pub struct ScopedRejectionCheckpoint {
+  pub handled: usize,
+  pub unhandled: usize,
+  pub deferred_ticks: bool,
+  pub deferred_termination: bool,
+}
+
+fn take_context_rows<T>(
+  scope: &mut v8::PinScope,
+  queue: &RefCell<VecDeque<T>>,
+  context: v8::Local<v8::Context>,
+  promise: impl Fn(&T) -> &v8::Global<v8::Promise>,
+) -> VecDeque<T> {
+  let rows = std::mem::take(&mut *queue.borrow_mut());
+  let mut selected = VecDeque::new();
+  let mut deferred = VecDeque::new();
+  for row in rows {
+    let value = v8::Local::new(scope, promise(&row));
+    if value.get_creation_context(scope) == Some(context) {
+      selected.push_back(row);
+    } else {
+      deferred.push_back(row);
+    }
+  }
+  queue.borrow_mut().extend(deferred);
+  selected
+}
+
+fn prepend_rows<T>(queue: &RefCell<VecDeque<T>>, mut rows: VecDeque<T>) {
+  rows.append(&mut *queue.borrow_mut());
+  *queue.borrow_mut() = rows;
+}
+
+fn mark_callback_entry(
+  scope: &mut v8::PinScope,
+  _args: v8::FunctionCallbackArguments,
+  _result: v8::ReturnValue,
+) {
+  JsRealm::exception_state_from_scope(scope)
+    .scoped_rejection_callback_entered
+    .set(true);
+}
+
+struct CallbackEntry<'a> {
+  flag: &'a std::cell::Cell<bool>,
+  previous: bool,
+}
+impl Drop for CallbackEntry<'_> {
+  fn drop(&mut self) {
+    self.flag.set(self.previous);
+  }
+}
+
+fn call_scoped_callback<'s>(
+  scope: &mut v8::PinScope<'s, '_>,
+  callback: v8::Local<'s, v8::Function>,
+  trampoline: &v8::Global<v8::Function>,
+  args: &[v8::Local<'s, v8::Value>],
+  entered: &std::cell::Cell<bool>,
+) -> (Option<v8::Local<'s, v8::Value>>, bool) {
+  // Entry means a dispatch attempt began, not that the user handler completed.
+  // A nested checkpoint restores this attempt's marker when it returns.
+  let marker = CallbackEntry {
+    flag: entered,
+    previous: entered.replace(false),
+  };
+  let value = (|| {
+    let mark = v8::Function::new(scope, mark_callback_entry)?;
+    let values = v8::Array::new_with_elements(scope, args);
+    let trampoline = v8::Local::new(scope, trampoline);
+    let undefined = v8::undefined(scope).into();
+    trampoline.call(
+      scope,
+      undefined,
+      &[mark.into(), callback.into(), values.into()],
+    )
+  })();
+  (value, marker.flag.get())
+}
+
+impl JsRuntime {
+  /// Report pending Promise rejection events from one exact context after its
+  /// task's microtask checkpoint, without polling native work or other contexts.
+  ///
+  /// nextTick processing is isolate-wide. If it is pending, leave the reports
+  /// queued for the ordinary event loop so a nextTick handler can still catch a
+  /// rejection before it is reported. The core drain's historically named
+  /// macrotask phase contains only nextTick/microtask work; it does not own a
+  /// separate macrotask callback queue. Foreign-context reports remain queued.
+  pub fn scoped_rejection_checkpoint(
+    &mut self,
+    context: &v8::Global<v8::Context>,
+  ) -> Result<ScopedRejectionCheckpoint, Box<JsError>> {
+    let mut result = ScopedRejectionCheckpoint::default();
+    if self.v8_isolate().is_execution_terminating() {
+      result.deferred_termination = true;
+      return Ok(result);
+    }
+    let state = self.inner.main_realm.0.context_state.clone();
+    if state.has_tick_scheduled() {
+      result.deferred_ticks = true;
+      return Ok(result);
+    }
+    scope!(scope, self);
+    let context = v8::Local::new(scope, context);
+    let exceptions = &state.exception_state;
+    let trampoline = state.js_scoped_rejection_cb.borrow().clone().unwrap();
+    let mut handled = take_context_rows(
+      scope,
+      &exceptions.pending_handled_promise_rejections,
+      context,
+      |row| &row.0,
+    );
+    while let Some((promise, reason)) = handled.pop_front() {
+      let callback = exceptions.js_handled_promise_rejection_cb.borrow().clone();
+      if let Some(callback) = callback {
+        v8::tc_scope!(let caught, scope);
+        let callback = v8::Local::new(caught, callback);
+        let args = [
+          v8::Local::new(caught, &promise).into(),
+          v8::Local::new(caught, &reason),
+        ];
+        let (_, entered) = call_scoped_callback(
+          caught,
+          callback,
+          &trampoline,
+          &args,
+          &exceptions.scoped_rejection_callback_entered,
+        );
+        if caught.has_terminated() || caught.is_execution_terminating() {
+          if !entered {
+            handled.push_front((promise, reason));
+          }
+          prepend_rows(&exceptions.pending_handled_promise_rejections, handled);
+          result.deferred_termination = true;
+          return Ok(result);
+        }
+        if let Some(exception) = caught.exception() {
+          prepend_rows(&exceptions.pending_handled_promise_rejections, handled);
+          return exception_to_err_result(caught, exception, false, true);
+        }
+      }
+      result.handled += 1;
+    }
+    if state.has_tick_scheduled() {
+      result.deferred_ticks = true;
+      return Ok(result);
+    }
+    let mut unhandled = take_context_rows(
+      scope,
+      &exceptions.pending_promise_rejections,
+      context,
+      |row| &row.0,
+    );
+    let callback = state.js_handle_rejections_cb.borrow().clone();
+    while let Some((promise, reason, stack)) = unhandled.pop_front() {
+      v8::tc_scope!(let caught, scope);
+      let callback = v8::Local::new(caught, callback.as_ref().unwrap());
+      let args = [
+        v8::Local::new(caught, &promise).into(),
+        v8::Local::new(caught, &reason),
+        v8::Local::new(caught, &stack),
+      ];
+      let (_, entered) = call_scoped_callback(
+        caught,
+        callback,
+        &trampoline,
+        &args,
+        &exceptions.scoped_rejection_callback_entered,
+      );
+      if caught.has_terminated() || caught.is_execution_terminating() {
+        if !entered {
+          unhandled.push_front((promise, reason, stack));
+        }
+        prepend_rows(&exceptions.pending_promise_rejections, unhandled);
+        result.deferred_termination = true;
+        return Ok(result);
+      }
+      if let Some(exception) = caught.exception() {
+        prepend_rows(&exceptions.pending_promise_rejections, unhandled);
+        return exception_to_err_result(caught, exception, false, true);
+      }
+      result.unhandled += 1;
+    }
+    scope.perform_microtask_checkpoint();
+    Ok(result)
+  }
+}
